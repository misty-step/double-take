{
  "name": "double-take",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:parlor": "pnpm --filter './vendor/parlor/**' -r build",
    "build": "pnpm build:parlor && next build",
    "dev": "node scripts/dev.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "reset": "node scripts/reset.mjs",
    "dev:web": "next dev --hostname 0.0.0.0 --port 3210",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:parlor": "vitest run --config scripts/vitest.vendor.mjs",
    "judge:probe": "node --experimental-strip-types scripts/judge-probe.mjs",
    "check": "pnpm build:parlor && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@parlor/auth": "workspace:*",
    "@parlor/convex": "workspace:*",
    "@parlor/core": "workspace:*",
    "@parlor/react": "workspace:*",
    "@parlor/web": "workspace:*",
    "convex": "1.45.0",
    "effect": "3.22.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "convex-test": "0.0.56",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.25.0"
}
