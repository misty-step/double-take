# pass-env reference file: entry names only, never values.
# Production build and deploy: pass-env run -f .env.pass -- <command>
# The Sentry DSN is public and lives in wrangler.jsonc and the build env (docs/deploy.md).
SENTRY_AUTH_TOKEN=workstation/SENTRY_AUTH_TOKEN
OPENROUTER_API_KEY=workstation/OPENROUTER_MISTY_STEP_DOUBLE_TAKE_SHARED_JUDGMENT_API_KEY
JEV_OPENROUTER_API_KEY=workstation/OPENROUTER_MISTY_STEP_DOUBLE_TAKE_JEV_API_KEY
CONVEX_DEPLOY_KEY=workstation/DOUBLETAKE_CONVEX_DEPLOY_KEY
